# Copie este arquivo para .env.local e preencha (opcional).
# ID do Google Tag Manager (ex.: GTM-XXXXXXX). Vazio = sem tracking.
VITE_GTM_ID=
# Endpoint alternativo do formulário (ex.: Formspree https://formspree.io/f/abcdwxyz).
# Vazio = usa o FormSubmit, que entrega no e-mail definido em src/config.ts.
VITE_FORM_ENDPOINT=

# URL pública do site (sem barra no final). Usada nas imagens de compartilhamento e links canônicos.
# Vazio = https://site-cientista-de-dados.vercel.app
VITE_SITE_URL=
